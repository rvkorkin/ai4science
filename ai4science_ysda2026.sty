% #1: 0 — порождено, 1 — написано, 2 — источник
\newcommand\ai@tagname[1]{%
  \ifai@english
    \ifcase#1 generated\or written\or source\fi
  \else
    \ifcase#1 порождено\or написано\or источник\fi
  \fi}
% #1 — вид пометки, #2 — примечание (может быть пустым)
\newcommand\ai@tag[2]{%
  \textcolor[gray]{0.4}{\footnotesize\upshape\mdseries
    \if\relax\detokenize{#2}\relax
      \mbox{[\ai@tagname{#1}]}%
    \else
      \mbox{[\ai@tagname{#1}:}~#2]%
    \fi}}
% #1 — вид пометки, #2 — примечание, #3 — помеченный фрагмент
\long\def\ai@mark#1#2#3{%
  \if\relax\detokenize{#3}\relax
    \ai@tag{#1}{#2}%
  \else
    #3\unskip\nobreak\hspace{0.3em}\ai@tag{#1}{#2}%
  \fi}
\NewDocumentCommand\porozhdeno{O{}+m}{\ai@mark{0}{#1}{#2}}
\NewDocumentCommand\napisano{O{}+m}{\ai@mark{1}{#1}{#2}}
\NewDocumentCommand\istochnik{O{}+m}{\ai@mark{2}{#1}{#2}}
\NewDocumentCommand\generated{O{}+m}{\ai@mark{0}{#1}{#2}}
\NewDocumentCommand\written{O{}+m}{\ai@mark{1}{#1}{#2}}
\NewDocumentCommand\sourced{O{}+m}{\ai@mark{2}{#1}{#2}}

